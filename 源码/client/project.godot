; Burning Chariot HD. Native-resolution UI; no legacy rendering hooks.
config_version=5

[application]
config/name="燃烧战车 高清重制版"
config/version="0.2.4"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://assets/app_icon.png"
run/main_scene="res://bootstrap.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/resizable=true
window/dpi/allow_hidpi=true
window/subwindows/embed_subwindows=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.085, 1)

[audio]
driver/enable_input=false
